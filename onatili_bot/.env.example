# BotFather'dan olingan bot tokeni
BOT_TOKEN=your_bot_token_here

# Baza fayli (ixtiyoriy). Bo'sh bo'lsa — onatili.db shu papkada
DB_PATH=

# ========== Esseni AI bilan tekshirish (45-savol) ==========
# off — o'chiq (o'qituvchi o'zi baholaydi) | gemini — Google Gemini (bepul tarifi bor) | claude — Anthropic Claude
AI_PROVIDER=off

# Gemini: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Gemini modeli (ixtiyoriy; bo'sh bo'lsa — gemini-flash-latest)
GEMINI_MODEL=
# Asosiy model band yoki limitda bo'lsa — zaxira model(lar), vergul bilan (bo'sh bo'lsa — standart ro'yxat)
GEMINI_FALLBACK=
# Yozma javoblar: bir so'rovda nechta titul (1–12, bo'sh bo'lsa — 8)
WRITTEN_BATCH=

# Esseni baholash xizmati (bo'sh bo'lsa — AI_PROVIDER). Sifatli baholash uchun: claude
# (yozma javoblar AI_PROVIDER'da qoladi — bepul Gemini yetadi)
ESSAY_PROVIDER=

# Claude: https://console.anthropic.com → API Keys (balans to'ldiriladi)
ANTHROPIC_API_KEY=
# Claude modeli (ixtiyoriy; bo'sh bo'lsa — claude-sonnet-5-5 ≈ 250–500 so'm/esse; claude-opus-5-5 — 2 barobar qimmat)
CLAUDE_MODEL=

# 1 — AI bahosi o'qituvchi tasdiqlamasa ham darhol qo'llanadi; 0 — o'qituvchi tasdiqlaydi (tavsiya)
ESSAY_AUTO_CONFIRM=0

# ========== Mini App ==========
# Ilova manzili (https). Render'da shart emas — u o'zi RENDER_EXTERNAL_URL beradi.
WEBAPP_URL=

# ========== Admin ==========
# Admin(lar)ning Telegram ID'si (botga /myid yozib bilib olasiz). Bir nechta: 123456,789012
# Admin botda /admin orqali majburiy obuna kanallarini qo'shadi va o'chiradi.
ADMIN_IDS=
# O'qituvchilar obuna uchun kimga yozadi (Telegram username, @ siz) — ilovada «Admin bilan bog'lanish»
ADMIN_CONTACT=
# Bepul foydalanuvchilar: obuna ham, to'lov ham so'ralmaydi (hammasi cheksiz). Bir nechta: 123456,789012
# Qolganlar ilovadagi «💎 Obuna» orqali sotib oladi: kartaga o'tkazadi → chekni botga yuboradi → admin tasdiqlaydi.
# Narx, chegirma, karta raqami va bepul sinov kunlari botda: /sozlama
FREE_IDS=

# Obuna sotish: 0 — yopiq (hozir): test yaratishni faqat FREE_IDS, ADMIN_IDS va admin botda /ruxsat bergan
# o'qituvchilar qila oladi, «💎 Obuna» bo'limi ko'rinmaydi. 1 — obuna sotiladi (karta → chek → admin).
PLANS_ENABLED=0

# ========== Baza ==========
# PostgreSQL manzili. Productionda SHART: Render'da fayl tizimi vaqtinchalik,
# SQLite fayli har deployda o'chib ketadi. Masalan (Neon): postgresql://user:parol@host/db?sslmode=require
# Bo'sh bo'lsa — SQLite (DB_PATH), faqat kompyuterda sinash uchun.
DATABASE_URL=

# ========== Xizmat ==========
# Render bepul tarifida server uxlab qolmasligi uchun o'z manziliga murojaat (1 — yoqiq, 0 — o'chiq)
KEEP_ALIVE=1

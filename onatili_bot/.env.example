# BotFather'dan olingan bot tokeni
BOT_TOKEN=your_bot_token_here

# Baza fayli (ixtiyoriy). Bo'sh bo'lsa — onatili.db shu papkada
DB_PATH=

# ========== Esseni AI bilan tekshirish (45-savol) ==========
# off — o'chiq (o'qituvchi o'zi baholaydi) | gemini — Google Gemini (bepul tarifi bor) | claude — Anthropic Claude
AI_PROVIDER=off

# Gemini: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Gemini modeli (ixtiyoriy; bo'sh bo'lsa — gemini-flash-latest)
GEMINI_MODEL=

# Claude: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Claude modeli (ixtiyoriy; bo'sh bo'lsa — claude-opus-5-5)
CLAUDE_MODEL=

# 1 — AI bahosi o'qituvchi tasdiqlamasa ham darhol qo'llanadi; 0 — o'qituvchi tasdiqlaydi (tavsiya)
ESSAY_AUTO_CONFIRM=0
